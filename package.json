{
  "name": "angular-agent-kit-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace for the Angular agent kit: the plugin files at the root, the design-tokens MCP server in packages/, and the migration example in examples/.",
  "license": "MIT",
  "author": "Alessandro Incantalupo",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "test": "vitest run",
    "build": "pnpm -r build",
    "validate": "node scripts/validate-kit.ts",
    "validate:links": "node scripts/validate-kit.ts --links",
    "mcp": "node packages/design-tokens-mcp/src/cli.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
